# Auto-generated data-flow topology from the Nix config. Do not edit.
# Regenerate: nix run .#diagram (or the lefthook pre-commit hook)
direction: right
classes: {
  app: { style: { fill: "#e6f0ff"; stroke: "#4a76c4" } }
  infra: { style: { fill: "#ffe9cc"; stroke: "#c47a29" } }
  base: { style: { fill: "#f0f0f0"; stroke: "#999"; font-size: 13 } }
}

internet: "🌐 Internet" { shape: cloud; style.fill: "#fdecea" }
lan: "🏠 LAN" { shape: cloud; style.fill: "#eafaf1" }

edge: "🖥️ edge" {
  style: { fill: "#fbfbfe"; stroke: "#333"; bold: true }
  headscale: "headscale\n(mesh control)" { class: infra }
  nginx: "nginx\n(reverse proxy)" { class: infra }
  beszel_hub: "beszel hub" { class: infra }
  base: "+ 18 system services" { class: base }
}
nas: "🖥️ nas" {
  style: { fill: "#fbfbfe"; stroke: "#333"; bold: true }
  prometheus: "prometheus" { class: infra }
  blackbox: "blackbox exporter" { class: infra }
  grafana: "grafana" { class: infra }
  subnet_router: "subnet router" { class: infra }
  assistant: "assistant" { class: app }
  cameras: "cameras" { class: app }
  chat: "chat" { class: app }
  gallery: "gallery" { class: app }
  git: "git" { class: app }
  health: "health" { class: app }
  healthapi: "healthapi" { class: app }
  kubicek: "kubicek" { class: app }
  ledfx: "ledfx" { class: app }
  music: "music" { class: app }
  party: "party" { class: app }
  qore: "qore" { class: app }
  vault: "vault" { class: app }
  base: "+ 24 system services" { class: base }
}
nixbook: "🖥️ nixbook" {
  style: { fill: "#fbfbfe"; stroke: "#333"; bold: true }
  base: "+ 28 system services" { class: base }
}
mac: "🍏 mac" {
  style: { fill: "#fbfbfe"; stroke: "#333"; bold: true }
  base: "+ 9 system services" { class: base }
}

