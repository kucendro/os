{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "timezone": "browser",
  "title": "Home",
  "uid": "home",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Endpoints down",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-home\"} == 0) or vector(0)",
          "legendFormat": "down",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Mesh endpoints", "url": "/d/home-endpoints" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed units",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(node_systemd_unit_state{state=\"failed\"}) or vector(0)",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Deploys", "url": "/d/deploys" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reboot needed",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(verify_reboot_needed == 1) or vector(0)",
          "legendFormat": "nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Deploys", "url": "/d/deploys" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last deploy",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "ci_run_success{job=\"ci\",workflow=\"deploy\"}",
          "legendFormat": "deploy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Deploys", "url": "/d/deploys" }],
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "failed", "color": "red" },
                "1": { "text": "ok", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hours since backup",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(time() - backup_last_success_timestamp_seconds{job=\"backup\"}) / 3600",
          "legendFormat": "hours",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Backups", "url": "/d/backups" }],
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 36 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Speed targets unreachable",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(iperf3_up{job=\"iperf3\"} == 0) or vector(0)",
          "legendFormat": "unreachable",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [{ "title": "Mesh speed", "url": "/d/mesh-iperf3" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "dashlist",
      "title": "Dashboards",
      "gridPos": { "h": 12, "w": 8, "x": 0, "y": 4 },
      "options": {
        "showStarred": false,
        "showRecentlyViewed": false,
        "showSearch": true,
        "showHeadings": false,
        "showFolderNames": true,
        "keepTime": false,
        "includeVars": false,
        "maxItems": 30,
        "query": "",
        "tags": []
      }
    },
    {
      "id": 8,
      "type": "alertlist",
      "title": "Alerts",
      "gridPos": { "h": 12, "w": 16, "x": 8, "y": 4 },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "viewMode": "list",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "error": true,
          "noData": false,
          "normal": false
        }
      }
    }
  ]
}
