{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "timezone": "browser",
  "title": "Mesh speed (iperf3)",
  "uid": "mesh-iperf3",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(iperf3_up{job=\"iperf3\"}, target)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets reachable",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(iperf3_up{job=\"iperf3\"})", "legendFormat": "up", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets unreachable",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(iperf3_up{job=\"iperf3\"} == 0) or vector(0)", "legendFormat": "down", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput per target / direction",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "iperf3_bandwidth_bits_per_second{job=\"iperf3\", target=~\"$target\"}", "legendFormat": "{{target}} {{direction}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "always", "pointSize": 5, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest throughput",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "iperf3_bandwidth_bits_per_second{job=\"iperf3\", target=~\"$target\"}", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true, "exported_job": true, "__name__": true },
            "indexByName": { "target": 0, "direction": 1, "Value": 2 },
            "renameByName": { "target": "Target", "direction": "Direction", "Value": "Throughput" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Throughput" },
            "properties": [ { "id": "unit", "value": "bps" }, { "id": "custom.cellOptions", "value": { "type": "gauge" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "Direction" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "tx": { "text": "edge → target" }, "rx": { "text": "target → edge" } } } ] }
            ]
          }
        ]
      }
    }
  ]
}
